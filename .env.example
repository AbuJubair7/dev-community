MONGO_URI=mongodb://localhost:27017/dev-community
PORT=3000
HOST=0.0.0.0
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h

# Email notification configuration (optional/development)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password_here

# Redis URL for BullMQ Post Scheduling (required)
REDIS_URL=redis://localhost:6379
